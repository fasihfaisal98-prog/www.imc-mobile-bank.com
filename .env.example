# ==========================================
# IMC MOBILE BANK - ENVIRONMENT CONFIGURATION
# ==========================================

# Firebase Project Configuration
# (Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=imcmobilebank.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=imcmobilebank
VITE_FIREBASE_STORAGE_BUCKET=imcmobilebank.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Cloudinary Image Upload (Optional for Unsigned Uploads)
# (Obtain from Cloudinary Dashboard -> Settings -> Upload Presets)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=imcmobile_unsigned
